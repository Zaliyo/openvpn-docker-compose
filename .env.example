# OpenVPN Server Configuration
# ============================

# Docker image - Replace with your Docker Hub image link
# Format: username/repo:tag or registry.example.com/repo:tag
DOCKER_IMAGE=zaliyo/openvpn:2.7.7

# Container name
CONTAINER_NAME=openvpn

# Public IP or hostname clients use to reach this server - written
# into the "remote" line of every generated .ovpn client file by
# create-clients. Must be reachable from wherever your clients connect
# from (this server's public IP/DNS name, not an internal address).
VPN_IP=203.0.113.10

# VPN Port
VPN_PORT=1194

# Debug mode (set to 1 to enable verbose logging)
DEBUG=0
